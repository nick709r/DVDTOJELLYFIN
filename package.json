{
  "name": "autodisc",
  "version": "1.16.0",
  "private": true,
  "description": "A lightweight DVD and music CD ingestion appliance for Jellyfin",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "tv-validation": "node scripts/tv-validation.js",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "10.1.6",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
